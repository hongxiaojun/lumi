{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumi",
  "version": "0.1.0",
  "identifier": "app.leaf.reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumi",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data: asset: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: asset:; font-src 'self' data: asset:; connect-src ipc: http://ipc.localhost https: http:; frame-src blob: asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "A calm EPUB and PDF reader",
    "longDescription": "Lumi is a local-first EPUB/PDF reader with annotations and desktop file storage.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB Book",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ]
  }
}
